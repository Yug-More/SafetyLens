# SafetyLens Frontend — Stage 1 Environment

# Copy this file to `.env.local` when integrating Stage 2 services.
# The Stage 1 frontend runs without any API keys.

# --- Future backend API ---
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Future multimodal AI provider (backend only; do not expose secrets to the browser) ---
# AI_API_KEY=

# --- Future database / storage (backend) ---
# DATABASE_URL=
# VECTOR_DATABASE_URL=
# EVIDENCE_STORAGE_URL=

# --- Future notification integrations (backend) ---
# NOTIFICATION_WEBHOOK_URL=
