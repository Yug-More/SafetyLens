APP_NAME=SafetyLens API
ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./safetylens.db
FRONTEND_ORIGINS=http://localhost:3000
DEMO_MODE=true
UPLOAD_DIRECTORY=./data/uploads
FRAME_DIRECTORY=./data/frames
MAX_VIDEO_SIZE_MB=100
MAX_VIDEO_DURATION_SECONDS=120
FRAME_SAMPLE_COUNT=10

# Stage 4 multimodal analysis
# Use "demo" for deterministic local analysis without credentials.
# Use "openai" only when OPENAI_API_KEY and VISION_MODEL are set.
AI_PROVIDER=demo
AI_DEMO_MODE=true
OPENAI_API_KEY=
VISION_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_MAX_FRAMES=8
AI_MAX_IMAGE_DIMENSION=1280
