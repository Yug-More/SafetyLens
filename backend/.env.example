APP_NAME=SafetyLens API
ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./safetylens.db
FRONTEND_ORIGINS=http://localhost:3000
DEMO_MODE=true
UPLOAD_DIRECTORY=./data/uploads
FRAME_DIRECTORY=./data/frames
MAX_VIDEO_SIZE_MB=100
MAX_VIDEO_DURATION_SECONDS=120
FRAME_SAMPLE_COUNT=10

# Stage 4 multimodal analysis
# Use "demo" for deterministic local analysis without credentials.
# Use "openai" only when OPENAI_API_KEY and VISION_MODEL are set.
AI_PROVIDER=demo
AI_DEMO_MODE=true
OPENAI_API_KEY=
VISION_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_MAX_FRAMES=8
AI_MAX_IMAGE_DIMENSION=1280

# Stage 5 procedure ingestion + grounded planning
PROCEDURE_DIRECTORY=./data/procedures
MAX_PROCEDURE_SIZE_MB=10
MAX_PROCEDURE_TEXT_CHARS=200000
PROCEDURE_CHUNK_MAX_CHARS=900
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.08
# Demo planner is deterministic and requires no paid API.
# Set PLANNER_PROVIDER=openai only with OPENAI_API_KEY and PLANNER_MODEL.

# Stage 6 approval, simulated execution, audit, PDF reports
REPORT_DIRECTORY=./data/reports
